# Copy this file to .env.local and fill in your values.
# Shopify admin → Settings → Apps and sales channels → install the "Headless" channel
# → create a storefront → copy the PUBLIC Storefront API access token.
# The public token is designed to be used in the browser, so NEXT_PUBLIC_ is fine here.
# Never put the PRIVATE token or an Admin API key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07
