# Copy this file to .env.local and fill in your values.
# Shopify admin → Settings → Apps and sales channels → install the "Headless" channel
# → create a storefront → copy the PUBLIC Storefront API access token.
# The public token is designed to be used in the browser, so NEXT_PUBLIC_ is fine here.
# Never put the PRIVATE token or an Admin API key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07

# Your real domain (used for canonical links, sitemap and og:image), e.g. https://himalayandrop.dk
NEXT_PUBLIC_SITE_URL=
# Google Search Console: the content value of the google-site-verification meta tag
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form → Shopify (server only, never NEXT_PUBLIC_): Admin API token with read_customers + write_customers.
# Messages appear in Shopify admin → Customers with the tag "contact-form" (text in the customer's Note).
SHOPIFY_ADMIN_TOKEN=
# Only if the site is hosted somewhere other than where /api/contact runs (e.g. the Cloudflare package):
# CONTACT_ALLOWED_ORIGIN=https://himalayandrop.dk
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://himalayan-drop-design.vercel.app/api/contact
NEXT_PUBLIC_GA_ID=
